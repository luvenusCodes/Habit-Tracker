# --- Application & Security ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
JWT_SECRET_KEY=replace_with_a_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# --- MySQL Database (Used by FastAPI + Docker MySQL Container) ---
DB_HOST=db
DB_PORT=3306
DB_USER=habit_user
DB_PASSWORD=replace_with_strong_db_password
DB_NAME=habits_storage_v2
DB_SSL_DISABLED=true
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# --- Email / OTP Service ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password